{
  "material": {
    "$description": "Glass levels. clear is for small controls floating over imagery or video: mostly see-through, with a strong saturation lift so it reads as glass. Alpha lives in the semantic mode files because it changes in dark mode.",
    "blur": {
      "$type": "dimension",
      "clear": { "$value": "12px" },
      "ultralight": { "$value": "8px" },
      "thin": { "$value": "16px" },
      "regular": { "$value": "24px" },
      "thick": { "$value": "32px" }
    },
    "saturation": {
      "$type": "number",
      "clear": { "$value": 1.6 },
      "ultralight": { "$value": 1.1 },
      "thin": { "$value": 1.1 },
      "regular": { "$value": 1.1 },
      "thick": { "$value": 1.0 }
    }
  },
  "shadow": {
    "$type": "shadow",
    "1": { "$value": { "offsetX": "0px", "offsetY": "2px", "blur": "8px", "spread": "0px", "color": "rgb(0 0 0 / 0.08)" } },
    "2": { "$value": { "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px", "color": "rgb(0 0 0 / 0.12)" } },
    "modal": { "$value": { "offsetX": "0px", "offsetY": "16px", "blur": "48px", "spread": "0px", "color": "rgb(0 0 0 / 0.18)" } }
  }
}
