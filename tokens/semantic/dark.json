{
  "color": {
    "$type": "color",
    "surface": {
      "canvas":   { "$value": "{color.cool.16}" },
      "card":     { "$value": "{color.cool.20}" },
      "inset":    { "$value": "{color.cool.24}" },
      "elevated": { "$value": "{color.cool.28}" }
    },
    "text": {
      "primary":   { "$value": "{color.warm.96}" },
      "secondary": { "$value": "{color.cool.78}" },
      "tertiary":  { "$value": "{color.cool.70}" }
    },
    "border": {
      "decorative": { "$value": "{color.cool.32}" },
      "control":    { "$value": "{color.cool.60}" }
    },
    "accent":    { "$value": "{color.brand-accent.dark}" },
    "on-accent": { "$value": "{color.cool.15}" },
    "danger":    { "$value": "{color.brand-danger.dark}" },
    "warning":   { "$value": "{color.brand-warning.dark}" },
    "success":   { "$value": "{color.brand-accent.dark}" },
    "fill": {
      "hover":   { "$value": "rgb(255 255 255 / 0.05)" },
      "pressed": { "$value": "rgb(255 255 255 / 0.08)" }
    },
    "focus": { "$value": "{color.brand-accent.dark}" },
    "scrim": { "$value": "rgb(0 0 0 / 0.48)" }
  },
  "material": {
    "tint-base": { "$type": "color", "$value": "{color.cool.20}" },
    "alpha": {
      "$type": "number",
      "ultralight": { "$value": 0.64 },
      "thin":       { "$value": 0.74 },
      "regular":    { "$value": 0.84 },
      "thick":      { "$value": 0.94 }
    }
  }
}
