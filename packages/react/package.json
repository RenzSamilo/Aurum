{
  "name": "@aurum/react",
  "version": "0.0.0",
  "description": "Aurum design system for React: tokens, base styles, and (from Phase 1) components.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./aurum.css": "./src/aurum.css",
    "./tokens.css": "./src/tokens/tokens.css",
    "./patterns": "./src/patterns/index.ts",
    "./kits/*": "./src/kits/*/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.2.8",
    "@phosphor-icons/react": "2.1.10"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.11.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
