{
  "name": "@aurum/react",
  "version": "0.1.0",
  "description": "Aurum design system for React: tokens, base styles and components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RenzSamilo/Aurum.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "aurum-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./aurum.css": {
      "aurum-source": "./src/aurum.css",
      "default": "./dist/aurum.css"
    },
    "./tokens.css": {
      "aurum-source": "./src/tokens/tokens.css",
      "default": "./dist/tokens/tokens.css"
    },
    "./patterns": {
      "aurum-source": "./src/patterns/index.ts",
      "types": "./dist/patterns/index.d.ts",
      "default": "./dist/patterns/index.js"
    },
    "./kits/*": {
      "aurum-source": "./src/kits/*/index.ts",
      "types": "./dist/kits/*/index.d.ts",
      "default": "./dist/kits/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.2.8",
    "@phosphor-icons/react": "2.1.10"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.11.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
